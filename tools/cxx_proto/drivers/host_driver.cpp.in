// Native CPU execution driver: the same column step in a loop over columns.
// No CUDA headers or libraries. Instantiated for one specialization by the
// Python glue (the @...@ fields), compiled with -ffp-contract=off.
#include "column_step.h"

extern "C" void substrate_step_host(const double* th_old, const double* ths_old,
                                    const double* absorbed, const double* dflux,
                                    const double* tref, const double* bottom, const double* rho,
                                    const double* kc, const double* chi, const double* dz,
                                    const double* half, const double* law_params,
                                    const pt::StepScalars* s, int n, double* th_out,
                                    double* ths_out, int* iters, int* fail, double* ratio_out) {
    for (int j = 0; j < n; ++j)
        pt::column_step<@L@, @LAW0@, @LAW1@>(j, n, th_old, ths_old, absorbed, dflux, tref, bottom,
                                             rho, kc, chi, dz, half, law_params, *s, th_out,
                                             ths_out, iters, fail, ratio_out);
}
