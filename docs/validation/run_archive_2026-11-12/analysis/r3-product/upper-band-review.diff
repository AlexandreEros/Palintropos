+def upper_band_pair(zeta_lm: cp.ndarray) -> dict[str, cp.ndarray]:
+    """Copy one analyzed IC; change only degrees above its production cut.
+
+    In particular, never synthesize/re-analyze the projected member: that
+    would change the shared low band and reintroduce quadrature leakage.
+    """
+    cut = (2 * (zeta_lm.shape[0] - 1)) // 3
+    projected = zeta_lm.copy()
+    projected[cut + 1:, :] = 0.0
+    return {"as_analyzed": zeta_lm.copy(), "upper_zeroed": projected}
+
