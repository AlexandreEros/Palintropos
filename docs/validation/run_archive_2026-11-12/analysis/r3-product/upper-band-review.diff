+class FrozenBandProbe:
+    """Observe every RK4 stage without modifying the production tendency."""
+
+    def __init__(self, model, initial):
+        self.model = model
+        self.cut = (2 * (initial.shape[0] - 1)) // 3
+        self.upper = initial[self.cut + 1:].copy()
+        self.state_change_max = 0.0
+        self.tendency_max = 0.0
+
+    def observe_state(self, coeffs):
+        if not bool(cp.isfinite(coeffs).all()):
+            raise FloatingPointError("nonfinite state in upper-band audit")
+        self.state_change_max = max(self.state_change_max, float(
+            cp.abs(coeffs[self.cut + 1:] - self.upper).max()))
+
+    def tendency(self, state, forcing_coeffs):
+        self.observe_state(state.coeffs)
+        dz = self.model.tendency(state, forcing_coeffs)
+        if not bool(cp.isfinite(dz).all()):
+            raise FloatingPointError("nonfinite tendency in upper-band audit")
+        self.tendency_max = max(self.tendency_max, float(
+            cp.abs(dz[self.cut + 1:]).max()))
+        return dz
+
