+    pair = audit.upper_band_pair(z0)
+    cp.testing.assert_array_equal(pair["as_analyzed"], original)
+    cp.testing.assert_array_equal(pair["upper_zeroed"][:CUT + 1], original[:CUT + 1])
+    assert float(cp.abs(original[CUT + 1:]).max()) > 0.0
+    assert float(cp.abs(pair["upper_zeroed"][CUT + 1:]).max()) == 0.0
+
+    model = BarotropicVorticity(planet, viscosity=0.0)
+    if quadrature == "coarse":
+        model.so = SpectralOperators(planet.sh, planet.params.radius, planet.grid,
+                                     product_quadrature="coarse")
+    result = audit.run_upper_band_pair(planet, z0, model, N=4, dt=2160.0)
+    cp.testing.assert_array_equal(z0, original)  # no in-place intervention
+    reference = spectral_diagnostics(pair["upper_zeroed"], planet.params.radius,
+                                     planet.params.angular_velocity)
+    for tag, initial in pair.items():
+        run = result["runs"][tag]
+        assert run["upper_state_change_max"] == 0.0
+        assert run["upper_tendency_max"] == 0.0
+        # Independent direct integration catches re-analysis of the projected IC,
+        # per-member CFL selection, or evolution with a different model.
+        state = BarotropicState(initial.copy())
+        for _ in range(4):
+            state = rk4_step(model, state, 0.0, 2160.0)
+        final = spectral_diagnostics(state.coeffs, planet.params.radius,
+                                     planet.params.angular_velocity)
+        # A symmetric finite difference of the quadratic invariants verifies
+        # the instantaneous production normalization independently of the audit.
+        dz = model.tendency(BarotropicState(initial), None)
+        plus = spectral_diagnostics(initial + 100.0 * dz, planet.params.radius,
+                                    planet.params.angular_velocity)
+        minus = spectral_diagnostics(initial - 100.0 * dz, planet.params.radius,
+                                     planet.params.angular_velocity)
+        for key in ("energy", "enstrophy_abs"):
+            assert run[key]["final"] == pytest.approx(final[key], rel=1e-13)
+            expected = (final[key] - run[key]["initial"]) / reference[key]
+            assert run[key]["change_over_common_initial"] == pytest.approx(expected)
+            rate = (plus[key] - minus[key]) / 200.0 * 86400.0 / reference[key]
+            assert run[key]["rate0_per_day_over_common"] == pytest.approx(
+                rate, rel=1e-7, abs=1e-12)
+    for key in ("energy", "enstrophy_abs"):
+        full = result["runs"]["as_analyzed"][key]
+        zero = result["runs"]["upper_zeroed"][key]
+        expected = ((full["final"] - full["initial"])
+                    - (zero["final"] - zero["initial"])) / reference[key]
+        assert result["paired_budget_difference"][key] == pytest.approx(expected)
