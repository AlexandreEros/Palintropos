# Generated architecture documentation (tools/architecture) is written with
# LF line endings; keep it LF on checkout so `--check` compares byte for byte.
docs/architecture/** text eol=lf
docs/architecture/*.png -text

# Published runs are byte-exact evidence (each carries a SHA256SUMS
# receipt); never convert their line endings.
docs/runs/** -text

# Test fixtures from real runs carry a SHA256SUMS receipt; keep their bytes.
tests/fixtures/** -text

# Verbatim third-party data (the CIE 1931 table is SHA-256 checked on load);
# never convert its line endings.
src/tropoi/spatial/optics/data/** -text

# The generated standalone sky page (python -m tools.sky_page); LF on checkout.
docs/sky.html text eol=lf
